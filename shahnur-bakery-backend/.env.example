NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/shahnur_bakery?replicaSet=rs0
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRE=7d
FRONTEND_URL=http://localhost:3000
# Set to the exact number of trusted reverse proxies in production (Render: 1).
# TRUST_PROXY_HOPS=1

# Optional image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP is required for password recovery emails
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=Shahnur Bakery <noreply@example.com>

# Used only by npm run create-admin; never committed with real values
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=+998901234567

# Optional order notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Delivery: maximum simultaneous orders in each hourly slot (Uzbekistan time)
DELIVERY_SLOT_CAPACITY=5

# Enable only after merchant registration, public HTTPS callbacks and provider testing.
# No real secrets belong in this example or in Git.
PAYMENTS_ENABLED=false
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
PAYME_TEST_MODE=true
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
